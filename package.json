{
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "lucide-react": "^1.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.1",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "description": "Nyein Sensei English — Duolingo-style English learning app for Myanmar speakers (Burmese UI). PWA, offline-first, Supabase-ready.",
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.63.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^5.0.2"
  },
  "name": "nyein-sensei-english",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:tenant": "node tools/tenant-test/run.mjs",
    "dedup-check": "python3 tools/vectorize/check.py",
    "visual:baseline": "node tools/visual-regression/capture.mjs --baseline",
    "visual:capture": "node tools/visual-regression/capture.mjs",
    "visual:compare": "node tools/visual-regression/compare.mjs",
    "visual-regression": "npm run visual:capture && npm run visual:compare"
  },
  "type": "module",
  "version": "1.0.0"
}
